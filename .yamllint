extends: default
rules:
  line-length: {max: 120, allow-non-breakable-inline-mappings: true}   # une URL ne se coupe pas
  document-start: disable
  comments: {min-spaces-from-content: 1}
  braces: {max-spaces-inside: 1}
  colons: {max-spaces-after: -1}   # les manifestes alignent leurs valeurs en colonnes, c'est voulu
  truthy: {check-keys: false}   # `on:` d'un workflow GitHub n'est pas un booléen
